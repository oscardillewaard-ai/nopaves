{
  "name": "nopaves",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "Nopav.es: hardlooproutes over onverharde paden in Nederland, volledig in de browser.",
  "scripts": {
    "serve": "python3 tools/serve.py",
    "test": "npm run test:unit && npm run lint",
    "test:unit": "node --test tests/test_web_kern.mjs tests/test_bgt.mjs",
    "test:graaf": "node --test tests/test_samenvoeg.mjs",
    "lint": "oxlint public",
    "test:mobiel": "node tests/test_web_nopaves.mjs test-uitvoer/mobiel mobiel",
    "test:desktop": "node tests/test_web_nopaves.mjs test-uitvoer/desktop desktop",
    "test:wandeling": "node tests/test_wandeling.mjs test-uitvoer/wandeling",
    "test:visueel": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "oxlint": "1.79.0",
    "playwright": "1.62.1"
  }
}
